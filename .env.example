# Copy to `.env` (gitignored) and fill in. Used by the evals (`evals/hosted_check.py`); load it into your shell with
#   set -a; . ./.env; set +a
# smart-commit-guard itself reads only real environment variables, never a `.env` file (see README, "Privacy").

# Local ollaya server (the default; nothing to set). For a hosted model, set all four:
SECRET_GUARD_BASE_URL=https://api.typesafe.ai
SECRET_GUARD_MODEL=jev-latest
SECRET_GUARD_ALLOW_HOSTED=1
SECRET_GUARD_API_KEY=
